{
  "name": "meme4me",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/overlay"
  ],
  "scripts": {
    "test": "npm run test -w @meme4me/core",
    "vendor": "node scripts/fetch-vendor.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "softcam": "node scripts/build-softcam.mjs",
    "setup": "npm install && npm run vendor && npm run icons && npm run softcam",
    "postinstall": "node scripts/gen-icons.mjs",
    "build:overlay": "npm run build -w @meme4me/overlay",
    "build:studio": "npm --prefix packages/studio run build",
    "build:front": "npm run build:overlay && npm run build:studio",
    "dev:front": "npm run build:overlay && npm --prefix packages/studio start",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:app": "node scripts/build-app.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
