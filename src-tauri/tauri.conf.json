{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deck4me",
  "version": "0.2.0",
  "identifier": "dev.deck4me.app",
  "build": {
    "frontendDist": "../packages/studio/dist/studio/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run dev:front",
    "beforeBuildCommand": "npm run build:front && node scripts/prepare-softcam.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "deck4me Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "backgroundColor": "#0e0d13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MehdiZen/meme4me/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1Mzg3RDA4RUQ2MDM5QzIKUldUQ09XRHRDSDA0RmZmUC9BRDhjMHBxb1p0U1UzdlFUSXhBdGEzUnlacDFmNGpZSkgweVp5TzUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/softcam/dist/bin/x64/softcam.dll": "softcam.dll"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh",
        "installMode": "perMachine"
      }
    }
  }
}
